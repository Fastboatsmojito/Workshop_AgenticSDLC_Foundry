# Copy to .env and fill in. .env is gitignored.
#
# Auth split for this workshop:
#   Foundry project + embeddings -> your `az login` identity (Entra, no key)
#   Azure AI Search              -> admin API key
# Keys in a file are not a production pattern. See infra/reference-architecture.md.

# --- Foundry project (guide 01) ---
# Project overview page in the Foundry portal, "Azure AI Foundry project endpoint".
# Copy it exactly - it can include a path such as /api/projects/<project-name>.
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL=gpt-4o-mini

# --- Embeddings (guide 02) ---
# Azure OpenAI endpoint on the same resource, ends with .openai.azure.com
FOUNDRY_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search (guide 01, used in guide 03) ---
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_API_KEY=your-admin-key
SEARCH_INDEX_NAME=sdlc-corpus

# --- Mock systems of record (started in guide 02) ---
# Take-home swaps these for the real Atlassian and GitHub MCP servers.
# The agent code does not change; only these URLs do.
MCP_JIRA_URL=http://127.0.0.1:8931/mcp
MCP_GITHUB_URL=http://127.0.0.1:8932/mcp
MCP_CONFLUENCE_URL=http://127.0.0.1:8933/mcp

# --- Who is approving ---
# Written into every approval record, so use something recognisable.
APPROVER_ALIAS=your.alias

# --- Optional: tracing (guide 07) ---
# Needs an Application Insights resource connected to the Foundry project.
# The connection string is read from the project, so there is nothing to paste.
ENABLE_TRACING=false
